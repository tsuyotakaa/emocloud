{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "soundcloud",
  "description": "Разрешает странице SoundCloud отправлять текущий трек в Discord",
  "windows": ["main"],
  "local": false,
  "remote": {
    "urls": ["https://soundcloud.com/*", "https://*.soundcloud.com/*"]
  },
  "permissions": ["allow-update-presence"]
}
